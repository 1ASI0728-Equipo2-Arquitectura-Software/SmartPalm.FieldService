# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development

# Local Docker dependencies
FIELD_API_PORT=5107
FIELD_DB_PORT=5439
FIELD_DB_NAME=smartpalm_field
FIELD_DB_USER=smartpalm
FIELD_DB_PASSWORD=replace-with-a-local-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ASP.NET variables shared by local and production
Jwt__Key=replace-with-at-least-32-random-characters
Jwt__Issuer=smartpalm.identity
Jwt__Audience=smartpalm.clients
RabbitMq__Enabled=false
RabbitMq__Uri=amqp://guest:guest@rabbitmq:5672/
RabbitMq__Exchange=smartpalm.events
RabbitMq__Queue=smartpalm.field

# Production overrides (remote PostgreSQL/RabbitMQ)
# FIELD_DB_HOST=10.6.96.4
# FIELD_DB_PORT=5432
# FIELD_DB_PASSWORD=replace-with-the-production-password
# ASPNETCORE_ENVIRONMENT=Production
# RabbitMq__Enabled=true
# RabbitMq__Uri=amqp://replace-user:replace-password@10.6.96.4:5672/
